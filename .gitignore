# Secrets — never commit HMRC credentials
.env
*.env
!.env.example

# Large inputs: the Companies House snapshot is ~470MB zipped.
# Do NOT commit it. Commit the download URL + the file's SHA256 + the row
# count instead, so the result is reproducible without the bulk.
data/companies_house/*.csv
data/companies_house/*.zip
data/raw/pages/
*.parquet

# Keep raw HMRC responses — they are the evidence trail and they are small.
!data/raw/hmrc/

# Veridion's brief, reproduced verbatim, kept on disk as the source of truth
# for this work. Not republished — it is their text, not mine. The tracked
# docs/ASSIGNMENT.md is a stub that points at the original instead.
docs/ASSIGNMENT.local.md

# Scratch: duplicate scaffold kept around during setup. Not part of the
# deliverable — unlike src/sources/, which keeps its failures on purpose.
_to_delete/

__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.DS_Store
