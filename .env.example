# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
# Sandbox returns stubbed test data. Production returns real HMRC records.
# Which one you are pointing at changes the meaning of every number you report,
# so make it explicit in the writeup, not implicit in an env var.
HMRC_ENV=sandbox

HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=

# Your own VAT number, if you use the /lookup/{vrn}/{requesterVrn} endpoint
# that returns a consultationNumber. Leave blank if you don't have one.
HMRC_REQUESTER_VRN=

# How this project identifies itself on every outbound request. Built by
# src/config.py, which reads these three. Nothing reads HMRC_USER_AGENT — that
# key existed here but no code ever looked at it, so it has been removed.
#
# VAT_CONTACT     a real address, so anyone seeing you in their logs can ask
# VAT_PROJECT_URL the public repo URL; omitted from the string when blank
# VAT_USER_AGENT  overrides the whole string; leave unset to let config.py build it
#
# Check what it produces with:  python src/config.py
VAT_CONTACT=
VAT_PROJECT_URL=
VAT_USER_AGENT=
